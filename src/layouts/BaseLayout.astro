---
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '../styles/tokens.css';
import Nav from '../components/Nav.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import type { Lang } from '../i18n/utils';
import { useTranslations, alternateLang, pathForLang } from '../i18n/utils';
import { operation, issuer, arrangerContact } from '../data/operation';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const alt = alternateLang(lang);
const canonical = new URL(pathForLang(lang), Astro.site).toString();
const altUrl = new URL(pathForLang(alt), Astro.site).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'FinancialProduct',
  name: operation.title,
  description: t.meta.description,
  url: canonical,
  category: operation.nature,
  interestRate: operation.interestRate,
  provider: {
    '@type': 'Organization',
    name: issuer.name,
    legalName: issuer.legalName,
    url: `https://${issuer.website}`,
    address: issuer.hqAddress,
    telephone: issuer.phones[0],
  },
  broker: {
    '@type': 'Organization',
    name: arrangerContact.name,
    url: `https://${arrangerContact.website}`,
  },
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-M7PHMGLM');</script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL('/', Astro.site).toString()} />
    <link rel="alternate" hreflang="en" href={new URL('/en', Astro.site).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).toString()} />
    <link rel="icon" href="/favicon.png" type="image/png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.ogTitle} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/img/og-cover.jpg', Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#1E7A2F" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="font-body text-encre bg-menthe-fond">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-M7PHMGLM"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <ScrollProgress />
    <Nav lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <Analytics />
    <SpeedInsights />

    <script>
      import '../scripts/animations';
    </script>
  </body>
</html>
